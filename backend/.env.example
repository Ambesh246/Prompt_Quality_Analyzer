# Comma-separated, exact allowed browser origins (no wildcard in production)
CORS_ORIGINS=http://localhost:5173
# Optional: only used for LLM rewrite; the scoring endpoint works without this key
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-sol
MODEL_DIR=./models
RATE_LIMIT_PER_MINUTE=30
